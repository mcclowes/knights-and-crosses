# Server configuration
PORT=3000
NODE_ENV=development

# Logging: error | warn | info | debug
# Defaults: production -> info, development -> debug, test -> warn
LOG_LEVEL=info

# CORS: comma-separated list of allowed browser origins for the WebSocket server.
# Required for a hybrid deployment where the frontend is served from a different
# host than the WebSocket server (e.g. Vercel frontend + Railway WS). If unset in
# production, only same-origin connections are accepted.
# ALLOWED_ORIGINS=https://your-frontend.example.com,https://www.example.com

# WebSocket endpoint the browser connects to (hybrid deployments only).
# Leave blank for same-origin (single-server) deployments.
NEXT_PUBLIC_WS_URL=http://localhost:3000

# Redis (Vercel Marketplace integration). Source of truth for game state and
# player stats. Without it, the server runs in-memory (single-instance/dev only).
# Format: redis://default:password@host:port  (or rediss:// for TLS)
# KV_URL=redis://default:your_password@your-redis-host:6379

# Horizontal-scaling groundwork (opt-in). Attaches the Socket.IO Redis adapter.
# Requires KV_URL and sticky sessions at the load balancer. See DEPLOYMENT.md
# "Path to horizontal scaling" — the game is single-instance until that work lands.
# ENABLE_REDIS_ADAPTER=false
